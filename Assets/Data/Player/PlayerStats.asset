  formulas: "\u3010\u57FA\u7840\u653B\u51FB\u4F24\u5BB3\u3011 = attack \xD7 0.15\n\u3010\u6280\u80FD\u4F24\u5BB3\u3011
    = (attack \xD7 0.15) \xD7 skillMultiplier \xD7 upgradeMult \xD7 (1 + critDamage
    if\u66B4\u51FB) + (elementDamage \xD7 0.1 if\u6709\u5C5E\u6027)\n\u3010\u6280\u80FD\u8303\u56F4\u3011
    = skillBaseRange + (attackRange \xD7 0.02)\n\u3010\u5B9E\u9645\u51B7\u5374\u3011
    = \u57FA\u7840\u51B7\u5374 - (attackSpeed \xD7 0.03 \xD7 0.2)\n\u3010\u9632\u5FA1\u51CF\u514D\u3011
    = defense \xD7 0.1 (\u51CF\u56FA\u5B9A\u503C)\n\u3010\u5143\u7D20\u9632\u5FA1\u51CF\u514D\u3011
    = elementDefense \xD7 0.1 (\u53EA\u5BF9\u540C\u5C5E\u6027\u653B\u51FB\u751F\u6548)\n\u3010\u6700\u7EC8\u4F24\u5BB3\u3011
    = max(1, \u6280\u80FD\u4F24\u5BB3 - \u9632\u5FA1\u51CF\u514D - \u5143\u7D20\u9632\u5FA1\u51CF\u514D)\n\u3010\u66B4\u51FB\u5224\u5B9A\u3011
    Random.value < critRate\n\u3010\u95EA\u907F\u5224\u5B9A\u3011 Random.value <
    dodgeRate\n\n\u3010\u5347\u7EA7\u516C\u5F0F\u3011 maxExp = level\xB2 \xD7 100\n\u3010\u7ECF\u9A8C\u7403\u3011
    Basic=20, Medium=200, Advanced=800"
  expBase: 100
  basicOrbExp: 20
  mediumOrbExp: 200
  advancedOrbExp: 800
